import sys
sys.setrecursionlimit(10000)


class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None


def exists(root, x):
    current = root

    while current is not None:
        if current.key == x:
            return True

        if x < current.key:
            current = current.left
        else:
            current = current.right

    return False


def add(root, x):
    if root is None:
        return Node(x)

    current = root

    while True:
        if x == current.key:
            return root

        if x < current.key:
            if current.left is None:
                current.left = Node(x)
                return root
            else:
                current = current.left
        else:
            if current.right is None:
                current.right = Node(x)
                return root
            else:
                current = current.right


def find_min(root):
    while root.left is not None:
        root = root.left

    return root


def delete(root, x):
    if root is None:
        return None

    if x < root.key:
        root.left = delete(root.left, x)

    elif x > root.key:
        root.right = delete(root.right, x)

    else:
        if root.left is None:
            return root.right

        if root.right is None:
            return root.left

        minimum = find_min(root.right)
        root.key = minimum.key
        root.right = delete(root.right, minimum.key)

    return root


def height(root):
    if root is None:
        return 0

    return 1 + max(height(root.left), height(root.right))


def preorder(root):
    if root is None:
        return

    print(root.key, end=" ")
    preorder(root.left)
    preorder(root.right)


Q = int(input())
root = None

for _ in range(Q):
    command = input().split()

    if command[0] == "add":
        x = int(command[1])
        root = add(root, x)

    elif command[0] == "del":
        x = int(command[1])
        root = delete(root, x)

    elif command[0] == "exists":
        x = int(command[1])

        if exists(root, x):
            print("YES")
        else:
            print("NO")

    elif command[0] == "height":
        print(height(root))

    elif command[0] == "print":
        if root is None:
            print("Empty")
        else:
            preorder(root)
            print()